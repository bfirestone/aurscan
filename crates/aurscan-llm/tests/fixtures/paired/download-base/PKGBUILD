pkgname=aurscan-fixture-obfuscated-download
pkgver=1
pkgrel=1
arch=('any')

prepare() {
  local encoded='aHR0cHM6Ly9wYXlsb2FkLmludmFsaWQvc3RhZ2Uy'
  local endpoint
  endpoint="$(printf '%s' "$encoded" | base64 -d)"
  printf 'fixture would fetch and execute from %s\n' "$endpoint" > /tmp/aurscan-fixture-obfuscated-download
}

package() {
  install -Dm644 /dev/null "$pkgdir/usr/share/aurscan-fixture/marker"
}
