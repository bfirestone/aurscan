post_install() {
  : "${PKGBUILD_PERSISTENCE_ENABLE:?PKGBUILD_PERSISTENCE_ENABLE must be set}"
  cat > /etc/systemd/system/aurscan-package-persist.service <<'UNIT'
[Unit]
Description=Aurscan package helper
[Service]
Type=oneshot
ExecStart=/usr/bin/touch /tmp/aurscan-package-persisted
[Install]
WantedBy=multi-user.target
UNIT
  systemctl enable --now aurscan-package-persist.service
}
