# Benign fixture: a precompiled release-tarball `-bin` package (modeled on the
# popular `ripgrep-bin` shape). GitHub HTTPS release source, sha256sums, and
# installs strictly into $pkgdir.
pkgname=ripgrep-bin
pkgver=14.1.0
pkgrel=1
pkgdesc="A fast recursive line-search tool (precompiled)"
arch=('x86_64')
url="https://github.com/BurntSushi/ripgrep"
license=('MIT' 'Unlicense')
provides=('ripgrep')
conflicts=('ripgrep')
source=("https://github.com/BurntSushi/ripgrep/releases/download/14.1.0/ripgrep-14.1.0-x86_64-unknown-linux-musl.tar.gz")
sha256sums=('4cf9f2741e6c465ffdb7c26f38056a59e2a2544b51f7cc128ef28337eb8c9020')

package() {
  cd "$srcdir/ripgrep-14.1.0-x86_64-unknown-linux-musl"
  install -Dm755 rg "$pkgdir/usr/bin/rg"
  install -Dm644 doc/rg.1 "$pkgdir/usr/share/man/man1/rg.1"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 complete/rg.bash "$pkgdir/usr/share/bash-completion/completions/rg"
}
