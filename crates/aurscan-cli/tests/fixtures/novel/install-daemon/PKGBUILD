# Novel-attack fixture: an otherwise ordinary package whose `.install` hook
# enables a persistent systemd daemon at root install time. The PKGBUILD itself
# is clean; the malicious shape lives in the install script (see pkg.install).
pkgname=sysmetrics
pkgver=1.0.0
pkgrel=1
pkgdesc="System metrics collector"
arch=('x86_64')
url="https://github.com/example/sysmetrics"
license=('MIT')
install=pkg.install
source=("https://github.com/example/sysmetrics/archive/v1.0.0.tar.gz")
sha256sums=('e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855')

package() {
  cd "$srcdir/sysmetrics-$pkgver"
  install -Dm755 sysmetrics "$pkgdir/usr/bin/sysmetrics"
}
