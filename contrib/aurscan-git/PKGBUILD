# Development recipe: build whatever this checkout's git history has, through
# the real makepkg + hook + install flow. The release PKGBUILD at the repo
# root pins a published tarball, so local changes never reach it; this one
# clones the local repo instead.
#
#   cd contrib/aurscan-git && makepkg -si
#
# Builds the *committed* state (git clone reads objects, not the worktree),
# so commit first. Not for the AUR: the file:// source only exists on this
# machine. An eventual aurscan-git AUR package would swap the source for
# git+https://github.com/bfirestone/aurscan.git and keep the rest.
pkgname=aurscan-git
pkgver=0.2.2.r1.gc700fdb # regenerated by pkgver() at build time
pkgrel=1
pkgdesc="High-performance AUR package scanner (development build from local git)"
arch=('x86_64')
url="https://github.com/bfirestone/aurscan"
license=('MIT')
depends=('pacman' 'glibc' 'gcc-libs')
optdepends=('paru: for paru-native PreBuildCommand integration')
provides=('aurscan')
conflicts=('aurscan')
install="aurscan.install"
makedepends=('cargo' 'git')
# Same tree-sitter + LTO interaction as the release PKGBUILD; see the
# comment there.
options=('!lto')
# Two levels up from this directory is the repo root, so this clones the
# local repository. SKIP is correct for a VCS source: there is no fixed byte
# string to hash, integrity comes from git itself.
source=("aurscan::git+file://$startdir/../..")
sha256sums=('SKIP')

pkgver() {
	cd "$srcdir/aurscan"
	git describe --long --tags --abbrev=7 | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
	cd "$srcdir/aurscan"
	cargo build --release --locked --bin aurscan
}

package() {
	cd "$srcdir/aurscan"
	install -Dm755 "target/release/aurscan" "$pkgdir/usr/bin/aurscan"
	install -Dm644 "data/aurscan.hook" "$pkgdir/usr/share/libalpm/hooks/aurscan.hook"
	install -Dm644 "README.md" "$pkgdir/usr/share/doc/$pkgname/README.md"
	install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
